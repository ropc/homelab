# global

{
    # debug
    acme_dns cloudflare {
        api_token "{{ cloudflare_api_key }}"
    }
    # homepage integration
    admin caddy:2019
}

# public

ropc.dev {
    root /srv # is this necessary?
    file_server

    # caching settings

    # agressively cache compressed assests
    @assets path *.png *.jpg *.jpeg *.svg *.mp4 *.m4a *.mp3 *.aac
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # For RSS, these are generated every 15 min, max age set accordingly
    @rss path *.rss
    header @rss Cache-Control "public, max-age=900, must-revalidate, proxy-revalidate"
    encode @rss
}

media.ropc.dev {
    reverse_proxy jellyfin:8096 {
        flush_interval -1
    }
}

photos.ropc.dev {
    @auth {
        path /api/auth/* /api/users/* /api/admin/*
    }
    # use vpn, this is only for sharing
    respond @auth 403

    reverse_proxy immich-server:2283 {
        flush_interval -1
    }
}

